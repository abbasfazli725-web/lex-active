{
  "name": "lex-active",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html README.md",
    "prebuild": "node scripts/check-public-config.mjs",
    "backend:local": "node scripts/local-backend.mjs",
    "backend:migrate:local": "node scripts/migrate-local.mjs",
    "test:backend": "node --test scripts/backend-integration.mjs",
    "test:cloud": "node scripts/test-cloud.mjs",
    "backend:functions:local": "node scripts/local-functions.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^26.0.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
